# Server bind configuration
HOST=0.0.0.0
PORT=3001

# Security: required API key for protected endpoints (header: X-API-KEY)
VOICE_API_KEY=change-me-in-production

# Optional integrations
DATABASE_URL=
FIRMWARE_BASE_URL=
EXTERNAL_VOICE_API_URL=

# Copy this file to .env and set values appropriately.
# These variables are read by the FastAPI backend at runtime.

# Required: API key for securing endpoints (header X-API-KEY)
VOICE_API_KEY=replace-with-strong-api-key

# Optional: PostgreSQL connection string (used for logging/state persistence in future)
# Example: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# Optional: Firmware service base URL to send commands to microcontroller
# Example: http://microcontroller-firmware:8001
FIRMWARE_BASE_URL=

# Optional: External voice recognition API endpoint
EXTERNAL_VOICE_API_URL=

